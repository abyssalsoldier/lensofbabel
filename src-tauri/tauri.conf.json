{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lens of Babel Translator",
  "version": "0.1.3",
  "identifier": "io.github.abyssalsoldier.lensofbabel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lens of Babel Translator",
        "url": "index.html",
        "width": 860,
        "height": 540,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "visible": false
      },
      {
        "label": "popup",
        "title": "Translation",
        "url": "popup.html",
        "width": 400,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 260,
        "minHeight": 90,
        "focus": false,
        "visible": false
      },
      {
        "label": "snip",
        "title": "Select text on screen",
        "url": "snip.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Lens of Babel Settings",
        "url": "settings.html",
        "width": 540,
        "height": 640,
        "minWidth": 460,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Lens of Babel",
    "copyright": "Copyright (c) 2026 abyssalsoldier",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Translate selected text in any window",
    "longDescription": "A tray app that translates selected text in any window with a hotkey.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "headerImage": "installer/nsis-header.bmp",
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/installer.nsi"
      },
      "wix": {
        "bannerPath": "installer/msi-banner.bmp",
        "dialogImagePath": "installer/msi-dialog.bmp"
      }
    }
  }
}
